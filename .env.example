# Docker Compose local environment.
# Copy this file to .env and fill real values locally.
# Do not commit .env.

NODE_ENV=production
BACKEND_PORT=5000
FRONTEND_PORT=80
CLIENT_URL=http://localhost,http://localhost:5173,https://green-bush-02922eb00.7.azurestaticapps.net

JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=8h
PRESENTER_PASSWORD=replace_with_presenter_password

DB_USER=your_sql_user
DB_PASSWORD=replace_with_sql_password
DB_SERVER=your-sql-server.database.windows.net
DB_DATABASE=ZiraAgile
DB_PORT=1433
DB_CONNECTION_TIMEOUT=60000
DB_REQUEST_TIMEOUT=60000
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=false

VITE_API_URL=/api
VITE_SOCKET_URL=http://localhost:5000
VITE_DEMO_MODE=false
